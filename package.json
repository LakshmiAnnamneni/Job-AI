{
  "name": "job-ai",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end test suite for Job AI, built with Playwright and TypeScript.",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc",
    "setup:gmail": "bash scripts/setup-gmail-mcp.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}

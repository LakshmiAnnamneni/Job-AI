# Copy to .env and fill in. .env is gitignored, so never commit real values.

# The site under test, without a trailing slash.
BASE_URL=https://staging.example.com

# A dedicated test account (not a real person's login).
TEST_USERNAME=
TEST_PASSWORD=

# Gmail importer (npm run tracker:gmail): YOUR OWN Google OAuth "Desktop app" client.
# See docs/SETUP.md, "Gmail access".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
